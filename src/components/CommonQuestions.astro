---
/**
 * The questions people actually arrive with, on the branch they belong to.
 *
 * These started on the home page, where eight of them made a wall. They work
 * far better here: someone already on /rights is in the right frame, and a
 * question in her words is a better door than a topic card called "Section 87".
 *
 * Every question links to a page that genuinely answers it — each was checked
 * against the destination page's own text. A question that leads somewhere
 * vague is worse than no question, because it teaches her the site does not
 * really have answers.
 */
export interface Question {
  q: string;
  href: string;
}

interface Props {
  questions: Question[];
  heading?: string;
}

const { questions, heading = 'People usually arrive asking' } = Astro.props;
---

{
  questions.length > 0 && (
    <section class="px-5 pb-8">
      <h2 class="text-xs font-semibold text-stone-400 tracking-widest uppercase mb-3">
        {heading}
      </h2>

      <ul class="list-none pl-0 m-0 flex flex-col gap-2">
        {questions.map((item) => (
          <li>
            <a
              href={item.href}
              class="group flex items-center gap-3 rounded-xl bg-surface-card border border-stone-200
                px-4 py-3.5 hover:border-clay-300 hover:bg-clay-50/40
                transition-colors duration-[var(--duration-normal)]"
            >
              <span class="text-[15px] leading-snug text-text-primary">{item.q}</span>
              <svg
                class="w-4 h-4 ml-auto shrink-0 text-stone-300 group-hover:text-clay-500 transition-colors"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
