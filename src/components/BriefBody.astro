---
/**
 * One edition, rendered.
 *
 * Takes the normalised shape, so it does not know or care whether it was
 * handed a daily or a weekly. The apparatus each item carries — what remains
 * unknown, what would move it next — is shown inline rather than collected at
 * the bottom, because those are the parts a reader needs while the claim is
 * still in front of them.
 */
import type { Edition } from '../lib/nations-data';
import SourceList from './evidence/SourceList.astro';

interface Props {
  edition: Edition;
}

const { edition } = Astro.props;

/** Superscript references into the numbered register. */
function refs(ids: number[]): string {
  return ids.length ? ids.join(', ') : '';
}
---

<div>
  {
    edition.lead && (
      <section class="mb-14">
        <h2>The one thing</h2>
        <h3>{edition.lead.headline}</h3>
        {edition.lead.paragraphs.map((p) => (
          <p>{p}</p>
        ))}

        {edition.lead.whyItMatters && (
          <div class="not-prose border-l-[3px] border-forest pl-5 my-7">
            <p class="font-body text-[10px] font-bold tracking-[0.14em] uppercase text-forest mb-1.5">
              Why it matters
            </p>
            <p class="text-[16px] leading-[1.65] text-ink m-0">{edition.lead.whyItMatters}</p>
          </div>
        )}

        {edition.lead.unknowns && edition.lead.unknowns.length > 0 && (
          <div class="not-prose bg-canvas/60 border border-rule rounded px-5 py-4 my-7">
            <p class="font-body text-[10px] font-bold tracking-[0.14em] uppercase text-stone-500 mb-2">
              What remains unknown
            </p>
            <ul class="list-disc pl-4 space-y-1.5 m-0">
              {edition.lead.unknowns.map((u) => (
                <li class="text-[15px] leading-[1.6] text-stone-700">{u}</li>
              ))}
            </ul>
          </div>
        )}

        {edition.lead.nextCatalyst && (
          <p class="not-prose text-[15px] leading-[1.65] text-stone-600 border-t border-rule pt-4 mt-6">
            <span class="font-body text-[10px] font-bold tracking-[0.14em] uppercase text-cedar mr-2">
              Next
            </span>
            {edition.lead.nextCatalyst}
          </p>
        )}

        {edition.lead.sourceIds.length > 0 && (
          <p class="not-prose text-xs text-text-muted mt-4">
            Sources {refs(edition.lead.sourceIds)}
          </p>
        )}
      </section>
    )
  }

  {
    edition.sections.map((section) => (
      <section class="mb-14">
        <h2>{section.title}</h2>
        {section.items.map((item) => (
          <article class="mb-10 last:mb-0">
            <h3>{item.headline}</h3>
            {item.paragraphs.map((p) => (
              <p>{p}</p>
            ))}

            {item.whyItMatters && (
              <div class="not-prose border-l-[3px] border-forest pl-5 my-6">
                <p class="font-body text-[10px] font-bold tracking-[0.14em] uppercase text-forest mb-1.5">
                  Why it matters
                </p>
                <p class="text-[16px] leading-[1.65] text-ink m-0">{item.whyItMatters}</p>
              </div>
            )}

            {item.unknowns && item.unknowns.length > 0 && (
              <div class="not-prose bg-canvas/60 border border-rule rounded px-5 py-4 my-6">
                <p class="font-body text-[10px] font-bold tracking-[0.14em] uppercase text-stone-500 mb-2">
                  What remains unknown
                </p>
                <ul class="list-disc pl-4 space-y-1.5 m-0">
                  {item.unknowns.map((u) => (
                    <li class="text-[15px] leading-[1.6] text-stone-700">{u}</li>
                  ))}
                </ul>
              </div>
            )}

            {item.nextCatalyst && (
              <p class="not-prose text-[15px] leading-[1.65] text-stone-600 mt-4">
                <span class="font-body text-[10px] font-bold tracking-[0.14em] uppercase text-cedar mr-2">
                  Next
                </span>
                {item.nextCatalyst}
              </p>
            )}

            {item.sourceIds.length > 0 && (
              <p class="not-prose text-xs text-text-muted mt-3">
                Sources {refs(item.sourceIds)}
              </p>
            )}
          </article>
        ))}
      </section>
    ))
  }

  {
    edition.sweep.length > 0 && (
      <section class="mb-14">
        <h2>The sweep</h2>
        {edition.sweep.map((group) => (
          <div class="mb-7 last:mb-0">
            <h3 class="!text-lg">{group.domain}</h3>
            <ul class="not-prose space-y-2.5 list-none pl-0 mt-3">
              {group.items.map((entry) => (
                <li class="text-[16px] leading-[1.6] text-ink pl-4 border-l border-rule">
                  {entry.line}
                  {entry.url && (
                    <a
                      href={entry.url}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="text-xs text-text-muted ml-2 whitespace-nowrap"
                    >
                      {entry.label ?? 'source'}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )
  }

  {
    edition.bright && (
      <section class="mb-14">
        <h2>The bright spot</h2>
        <h3>{edition.bright.headline}</h3>
        {edition.bright.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        {edition.bright.sourceIds.length > 0 && (
          <p class="not-prose text-xs text-text-muted mt-3">
            Sources {refs(edition.bright.sourceIds)}
          </p>
        )}
      </section>
    )
  }

  {
    edition.whatHappensNext.length > 0 && (
      <section class="mb-14">
        <h2>What happens next</h2>
        <ul>
          {edition.whatHappensNext.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    edition.stillWatching.length > 0 && (
      <section class="mb-14">
        <h2>Still watching</h2>
        <ul>
          {edition.stillWatching.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-16">
    <SourceList sources={edition.sources} />
  </div>
</div>
