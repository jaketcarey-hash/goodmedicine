---
/**
 * The Strong Fire mark — a flame held inside a circle.
 *
 * Rendered inline rather than as an <img> so it inherits the page's colour
 * treatment and stays crisp at any size. The gradient id is suffixed per
 * instance so two marks on one page cannot collide.
 */
interface Props {
  size?: number;
  class?: string;
  id?: string;
}

const { size = 28, class: className = '', id = 'mark' } = Astro.props;
const gradientId = `sf-${id}`;
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} x1="50%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" style="stop-color:#9a6d3a" />
      <stop offset="40%" style="stop-color:#b8864e" />
      <stop offset="100%" style="stop-color:#cda577" />
    </linearGradient>
  </defs>
  <circle cx="16" cy="16" r="14" fill={`url(#${gradientId})`} />
  <path
    d="M16 6c-1.5 4-5 7-5 12a5 5 0 0010 0c0-5-3.5-8-5-12z"
    fill="none"
    stroke="#faf8f5"
    stroke-width="1.5"
    stroke-linejoin="round"
  />
  <path
    d="M16 12c-0.8 2-2.5 3.5-2.5 6a2.5 2.5 0 005 0c0-2.5-1.7-4-2.5-6z"
    fill="#faf8f5"
    opacity="0.4"
  />
</svg>
