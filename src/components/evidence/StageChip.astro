---
/**
 * Where a development sits on the road from first conversation to operating.
 *
 * The ledger's stage vocabulary is the useful part of the whole dataset: an
 * MOU and a financial close both make headlines, and only one of them is money
 * that has actually moved. Grouping the eighteen stages into four bands lets a
 * reader see that distinction at a glance without losing the exact stage.
 */
interface Props {
  stage: string;
  size?: 'sm' | 'md';
}

const { stage, size = 'sm' } = Astro.props;

/** The four bands, in order of how settled the thing is. */
const BANDS: Record<string, string[]> = {
  early: ['discussion', 'proposal', 'consultation', 'option'],
  committed: ['MOU', 'legislation introduced', 'financing committed'],
  done: [
    'provincial ratification',
    'legally effective',
    'permit or approval',
    'financial close',
    'transaction closed',
    'construction',
    'operational',
    'implementation',
  ],
  contested: ['litigation', 'judgment', 'restructuring'],
};

const tone: Record<string, string> = {
  early: 'bg-stone-100 text-stone-600 border-stone-200',
  committed: 'bg-clay-50 text-clay-700 border-clay-200',
  done: 'bg-forest/10 text-forest border-forest/20',
  contested: 'bg-berry-50 text-berry-700 border-berry-200',
};

const band =
  Object.entries(BANDS).find(([, stages]) =>
    stages.some((s) => s.toLowerCase() === stage.toLowerCase()),
  )?.[0] ?? 'early';

const sizing = size === 'md' ? 'text-xs px-2.5 py-1' : 'text-[10px] px-2 py-0.5';
---

<span
  class:list={[
    'inline-flex items-center rounded border font-medium tracking-wide whitespace-nowrap',
    tone[band],
    sizing,
  ]}
>
  {stage}
</span>
