---
/**
 * The quiet end of the evidence apparatus.
 *
 * On the Record surface a reader wants the full register — confidence, stage,
 * unknowns, numbered sources. On the community surface, someone reading about
 * their own child benefit wants one thing: is this number still true? This is
 * that, and nothing more.
 */
interface Props {
  date: string;
  source?: string;
  label?: string;
}

const { date, source, label = 'Verified' } = Astro.props;
---

<span class="inline-flex items-center gap-1.5 text-[11px] text-text-muted">
  <svg
    class="w-3 h-3 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 6L9 17l-5-5" />
  </svg>
  {
    source ? (
      <>
        {label} {date} &middot;{' '}
        <a href={source} rel="noopener noreferrer" target="_blank" class="underline hover:text-text-secondary">
          source
        </a>
      </>
    ) : (
      <>
        {label} {date}
      </>
    )
  }
</span>
