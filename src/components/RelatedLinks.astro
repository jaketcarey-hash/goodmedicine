---
interface Link {
  href: string;
  title: string;
  description?: string;
}

interface Props {
  branch: 'money' | 'rights' | 'path' | 'self';
  heading?: string;
  links: Link[];
}

// `branch` is accepted for compatibility but no longer colours the list —
// colour on this site carries meaning, and a section is not a meaning.
const { heading = 'Where to next', links } = Astro.props;
---

<nav class="related" aria-label={heading}>
  <p class="related__heading">{heading}</p>
  <ul class="related__list">
    {links.map((link) => (
      <li>
        <a href={link.href} class="related__item">
          <span class="related__title">{link.title}</span>
          {link.description && <span class="related__desc">{link.description}</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }

  .related__heading {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-faint);
    margin-bottom: 1rem;
  }

  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .related__item {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .related__title {
    display: block;
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 2px;
    transition: text-decoration-color 150ms;
  }

  .related__item:hover .related__title {
    text-decoration-color: var(--color-ink);
  }

  .related__desc {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-quiet);
    line-height: 1.5;
    margin-top: 0.125rem;
  }
</style>
