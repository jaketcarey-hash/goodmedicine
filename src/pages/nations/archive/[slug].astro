---
/**
 * A single edition.
 *
 * The route is /nations/archive/YYYY-MM-DD, which is the address these
 * editions have always had — the weekday automation checks it, and anything
 * already shared points at it. Weekly editions keep their -weekly suffix.
 */
import type { GetStaticPaths } from 'astro';
import Record from '../../../layouts/Record.astro';
import BriefBody from '../../../components/BriefBody.astro';
import { getEditions, formatDate } from '../../../lib/nations-data';
import Crossings from '../../../components/Crossings.astro';

export const getStaticPaths = (() => {
  const editions = getEditions();
  return editions.map((edition, i) => ({
    params: { slug: edition.slug },
    props: {
      edition,
      newer: editions[i - 1] ?? null,
      older: editions[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { edition, newer, older } = Astro.props;
---

<Record
  title={`${edition.title} — ${formatDate(edition.date)}`}
  description={edition.headline}
  kicker={edition.title}
  heading={edition.headline}
  standfirst={edition.throughLine || undefined}
  dateline={`${edition.dateLong}${edition.readTime ? ` · ${edition.readTime}` : ''}`}
  hasRail={true}
>
  <BriefBody edition={edition} />

  <Crossings
    subject={[
      edition.headline,
      edition.throughLine,
      edition.lead?.headline ?? '',
      ...edition.sections.flatMap((s) => s.items.map((i) => i.headline)),
    ].join(' ')}
  />

  <nav
    class="not-prose grid grid-cols-2 gap-6 mt-16 pt-6 border-t border-rule"
    aria-label="Other editions"
  >
    <div>
      {
        older && (
          <a href={older.url} class="group block">
            <span class="apparatus-label block mb-2">Previous</span>
            <span class="block text-[15px] leading-snug text-ink font-medium group-hover:underline decoration-rule underline-offset-2">
              {older.headline}
            </span>
          </a>
        )
      }
    </div>
    <div class="text-right">
      {
        newer && (
          <a href={newer.url} class="group block">
            <span class="apparatus-label block mb-2">Next</span>
            <span class="block text-[15px] leading-snug text-ink font-medium group-hover:underline decoration-rule underline-offset-2">
              {newer.headline}
            </span>
          </a>
        )
      }
    </div>
  </nav>

  <Fragment slot="evidence">
    <dl class="flex flex-wrap gap-x-8 gap-y-4 lg:flex-col lg:gap-y-5 m-0">
      <div>
        <dt class="apparatus-label mb-1.5">Edition</dt>
        <dd class="apparatus m-0 text-[11px] text-ink">
          {edition.cadence === 'weekly' ? 'Weekly' : 'Daily'} · {formatDate(edition.date)}
        </dd>
      </div>
      {
        edition.status === 'verified_public_sources' && (
          <div>
            <dt class="apparatus-label mb-1.5">Verified against</dt>
            <dd class="apparatus m-0 text-[11px] text-verified">Public sources only</dd>
          </div>
        )
      }
      <div>
        <dt class="apparatus-label mb-1.5">Sources</dt>
        <dd class="apparatus m-0 text-[11px] text-ink">{edition.sources.length} in the register</dd>
      </div>
    </dl>
  </Fragment>

  <Fragment slot="rail">
    <a
      href="/nations/archive"
      class="text-sm font-medium text-ink underline decoration-rule underline-offset-2 hover:decoration-ink"
    >
      All editions &rarr;
    </a>
  </Fragment>
</Record>
