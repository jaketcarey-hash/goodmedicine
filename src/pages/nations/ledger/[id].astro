---
/**
 * One development, in full.
 *
 * The dossier holds more per record than any list can show — competing
 * perspectives, unresolved questions, what would move it next. This is where
 * that lives, and it is the reason each record has a stable URL.
 */
import type { GetStaticPaths } from 'astro';
import Record from '../../../layouts/Record.astro';
import SourceList from '../../../components/evidence/SourceList.astro';
import ConfidenceBadge from '../../../components/evidence/ConfidenceBadge.astro';
import StageRail from '../../../components/evidence/StageRail.astro';
import { formatDate } from '../../../lib/nations-data';
import { getEntries, BAND_MEANING } from '../../../lib/ledger';
import { slugify } from '../../../lib/nations-index';
import Crossings from '../../../components/Crossings.astro';

export const getStaticPaths = (() => {
  const entries = getEntries();
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      newer: entries[i - 1] ?? null,
      older: entries[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { entry, newer, older } = Astro.props;

// Primary sources and independent verification share the register, but the
// distinction matters — so they keep their own headings.
const primary = ((entry.primary_sources as { title: string; url: string }[]) ?? []).map(
  (s, i) => ({ id: i + 1, label: s.title, url: s.url }),
);
const verification = (
  (entry.independent_verification as { title: string; url: string }[]) ?? []
).map((s, i) => ({ id: primary.length + i + 1, label: s.title, url: s.url }));

const dissent = entry.dissent_or_competing_perspective as string | null;
const unresolved = entry.unresolved_questions as string[] | string | null;
const unresolvedList = Array.isArray(unresolved)
  ? unresolved
  : unresolved
    ? [unresolved]
    : [];
const statusAsOf = entry.status_as_of_2026_07_15 as string | null;
const nextCatalyst = entry.next_catalyst as string | null;
const mechanisms = (entry.economic_mechanism as string[]) ?? [];
const governments = (entry.governments as string[]) ?? [];
const companies = (entry.companies_and_assets as string[]) ?? [];
---

<Record
  {/* The event, not the record id — this is the browser tab and the search result. */}
  title={entry.event}
  description={(entry.significance as string) ?? entry.event}
  kicker="Ledger record"
  heading={entry.event}
  standfirst={(entry.significance as string) ?? undefined}
  dateline={`${formatDate(entry.date)}${entry.effective_date ? ` · effective ${formatDate(entry.effective_date)}` : ''}`}
  hasRail={true}
>
  <div class="not-prose flex flex-wrap items-center gap-x-6 gap-y-3 -mt-4 mb-10 pb-6 border-b border-rule">
    <StageRail band={entry.band} stage={entry.stage} size="md" />
    <ConfidenceBadge level={entry.confidence} size="md" />
  </div>

  {
    entry.amountLabel && (
      <div class="not-prose border border-rule bg-canvas/50 rounded px-5 py-4 mb-10">
        <p class="font-record text-2xl text-ink tabular-nums leading-none mb-2">
          {entry.amountLabel}
        </p>
        <p class="text-sm leading-relaxed text-text-secondary">
          {entry.amountQualifier ?? 'No qualifier recorded for this figure.'}
        </p>
      </div>
    )
  }

  {
    statusAsOf && (
      <section class="mb-10">
        <h2>Where it stands</h2>
        <p>{statusAsOf}</p>
      </section>
    )
  }

  {
    nextCatalyst && (
      <section class="mb-10">
        <h2>What would move it next</h2>
        <p>{nextCatalyst}</p>
      </section>
    )
  }

  {
    dissent && (
      <section class="mb-10">
        <h2>The other view</h2>
        <p>{dissent}</p>
      </section>
    )
  }

  {
    unresolvedList.length > 0 && (
      <section class="mb-10">
        <h2>Unresolved</h2>
        <ul>
          {unresolvedList.map((q) => (
            <li>{q}</li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-14 space-y-10">
    {primary.length > 0 && <SourceList sources={primary} heading="Primary sources" />}
    {
      verification.length > 0 && (
        <SourceList sources={verification} heading="Independent verification" />
      )
    }
    {
      verification.length === 0 && (
        <p class="not-prose text-sm text-text-muted border-l-[3px] border-clay-300 pl-4">
          No independent verification is recorded for this entry. That is part of why it
          carries the confidence rating it does.
        </p>
      )
    }
  </div>

  <Crossings
    subject={[
      entry.event,
      entry.significance as string,
      ...entry.sectors,
      ...mechanisms,
    ].join(' ')}
  />

  <nav
    class="not-prose grid grid-cols-2 gap-6 mt-16 pt-8 border-t border-rule"
    aria-label="Other records"
  >
    <div>
      {
        older && (
          <a href={`/nations/ledger/${older.id}`} class="group block">
            <span class="block text-[10px] font-bold tracking-[0.14em] uppercase text-stone-500 mb-2">
              Earlier
            </span>
            <span class="block font-record text-[15px] leading-snug text-ink group-hover:text-cedar transition-colors">
              {older.event}
            </span>
          </a>
        )
      }
    </div>
    <div class="text-right">
      {
        newer && (
          <a href={`/nations/ledger/${newer.id}`} class="group block">
            <span class="block text-[10px] font-bold tracking-[0.14em] uppercase text-stone-500 mb-2">
              Later
            </span>
            <span class="block font-record text-[15px] leading-snug text-ink group-hover:text-cedar transition-colors">
              {newer.event}
            </span>
          </a>
        )
      }
    </div>
  </nav>

  <Fragment slot="rail">
    <div class="border-t border-rule pt-5 space-y-6">
      <div>
        <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-stone-500 mb-2">
          Stage
        </p>
        <p class="text-sm leading-relaxed text-text-secondary">{BAND_MEANING[entry.band]}</p>
      </div>

      {
        entry.nations.length > 0 && (
          <div>
            <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-stone-500 mb-2">
              Nations and organizations
            </p>
            <ul class="space-y-1.5">
              {entry.nations.map((n) => (
                <li class="text-sm leading-snug">
                  <a
                    href={`/nations/who/${slugify(n)}`}
                    class="text-ink hover:text-cedar transition-colors"
                  >
                    {n}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        governments.length > 0 && (
          <div>
            <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-stone-500 mb-2">
              Governments
            </p>
            <ul class="space-y-1.5">
              {governments.map((g) => (
                <li class="text-sm text-ink leading-snug">{g}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        companies.length > 0 && (
          <div>
            <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-stone-500 mb-2">
              Companies and assets
            </p>
            <ul class="space-y-1.5">
              {companies.map((c) => (
                <li class="text-sm text-ink leading-snug">{c}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        entry.places.length > 0 && (
          <div>
            <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-stone-500 mb-2">
              Where
            </p>
            <p class="text-sm text-ink leading-snug">{entry.places.join(', ')}</p>
          </div>
        )
      }

      {
        mechanisms.length > 0 && (
          <div>
            <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-stone-500 mb-2">
              Mechanism
            </p>
            <p class="text-sm text-ink leading-snug">{mechanisms.join(', ')}</p>
          </div>
        )
      }

      <div class="pt-4 border-t border-rule">
        <p class="text-xs text-text-muted mb-3">Record {entry.id}</p>
        <a
          href="/nations/ledger"
          class="text-sm font-semibold text-cedar hover:text-cedar-dark transition-colors"
        >
          &larr; All records
        </a>
      </div>
    </div>
  </Fragment>
</Record>
