---
import Shell from '../../layouts/Shell.astro';
import PageHeader from '../../components/PageHeader.svelte';
import TaxEstimator from '../../components/TaxEstimator.svelte';
---

<Shell title="Tax Estimator" branch="money" description="See what you'll owe — or what you'll get back.">
  <PageHeader
    title="Tax Estimator"
    subtitle="See what you'll owe — or what you'll get back."
    branch="money"
    backHref="/money"
    backLabel="Money"
  />

  <section class="px-5 pb-10">
    <TaxEstimator client:load />
    <p class="mt-6 text-sm text-quiet">
      The thinking behind this tool:
      <a href="/money/taxes" class="text-ink underline decoration-rule underline-offset-2 hover:decoration-ink">Taxes and Filing</a>
    </p>
  </section>
</Shell>
