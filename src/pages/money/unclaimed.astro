---
import Shell from '../../layouts/Shell.astro';
import PageHeader from '../../components/PageHeader.svelte';
import Unclaimed from '../../components/Unclaimed.svelte';
import YourNation from '../../components/YourNation.svelte';
import { getBcNations } from '../../lib/bc-nations';

const nations = getBcNations().map((n) => ({
  name: n.name, slug: n.slug, people: n.people, tribalCouncil: n.tribalCouncil,
  bandNumber: n.bandNumber,
}));

const description =
  'Benefits are paid from a filed return, and CRA reaches back ten years. Four questions about your household work out what filing the missing years could be worth.';
---

<Shell
  title="Am I owed money I haven't claimed?"
  branch="money"
  description={description}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [{
      '@type': 'Question',
      name: "Am I owed money I haven't claimed?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'If tax returns have not been filed, benefits paid from them have not been paid either. The Canada Child Benefit and the Canada Groceries and Essentials Benefit are both claimed by filing, CRA will reach back up to ten years, and back payments are calculated once the returns are in.',
      },
    }],
  }}
>
  <PageHeader
    title="Am I owed money I haven't claimed?"
    subtitle="Benefits are paid from a filed return, and a return can be filed years late. Four questions about your household, then the arithmetic."
    branch="money"
    backHref="/money"
    backLabel="Money"
  />

  <section class="px-5 pb-10">
    <Unclaimed client:load />

    <div class="mt-10">
      <YourNation client:idle {nations} />
    </div>
  </section>
</Shell>
