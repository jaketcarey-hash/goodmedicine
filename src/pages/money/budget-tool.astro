---
import Shell from '../../layouts/Shell.astro';
import PageHeader from '../../components/PageHeader.svelte';
import BudgetTool from '../../components/BudgetTool.svelte';
---

<Shell title="Budget Tool" branch="money" description="A clear picture of what comes in and what goes out. No judgment, just numbers.">
  <PageHeader
    title="Budget Tool"
    subtitle="A clear picture of what comes in and what goes out. No judgment, just numbers."
    branch="money"
    backHref="/money"
    backLabel="Money"
  />

  <section class="px-5 pb-10">
    <BudgetTool client:load />
    <p class="mt-6 text-sm text-quiet">
      The thinking behind this tool:
      <a href="/money/budgeting" class="text-ink underline decoration-rule underline-offset-2 hover:decoration-ink">Budgeting That Works</a>
    </p>
  </section>
</Shell>
