---
import Shell from '../../layouts/Shell.astro';
import PageHeader from '../../components/PageHeader.svelte';
import SavingsTracker from '../../components/SavingsTracker.svelte';
---

<Shell title="Savings Tracker" branch="money" description="Set a goal, watch it grow. Every deposit counts.">
  <PageHeader
    title="Savings Tracker"
    subtitle="Set a goal, watch it grow. Every deposit counts."
    branch="money"
    backHref="/money"
    backLabel="Money"
  />

  <section class="px-5 pb-10">
    <SavingsTracker client:load />
    <p class="mt-6 text-sm text-quiet">
      The thinking behind this tool:
      <a href="/money/saving" class="text-ink underline decoration-rule underline-offset-2 hover:decoration-ink">Saving and Growing</a>
    </p>
  </section>
</Shell>
