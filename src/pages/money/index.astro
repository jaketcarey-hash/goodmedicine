---
import Shell from '../../layouts/Shell.astro';
import PageHeader from '../../components/PageHeader.svelte';
import CommonQuestions from '../../components/CommonQuestions.astro';
import TopicCard from '../../components/TopicCard.svelte';

const QUESTIONS = [
  { q: 'Do I have to file taxes if my income is exempt?', href: '/money/taxes' },
  { q: 'What am I actually entitled to?', href: '/self/benefits' },
  { q: "I'm short this month.", href: '/moments/short-this-month' },
  { q: 'How do I stop paying so much interest?', href: '/money/debt' },
];
---

<Shell title="Knowing Your Money" branch="money" description="Practical tools for everyday financial decisions. Start broad, go as deep as you need.">
  <PageHeader
    title="Knowing Your Money"
    subtitle="Practical tools for everyday financial decisions. Start broad, go as deep as you need."
    branch="money"
    backHref="/"
    backLabel="Home"
  />

  <CommonQuestions questions={QUESTIONS} />

  <!-- Interactive tools -->
  <section class="px-5 pb-6">
    <h2 class="text-xs font-semibold text-faint tracking-widest uppercase mb-3">Tools</h2>
    <div class="flex flex-col gap-2.5">
      <a href="/money/plan" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" /><path d="M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36z" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">Your Money Plan</p>
          <p class="text-xs text-text-muted">Where you're headed, and where you stand — from what you've already entered</p>
        </div>
      </a>
      <a href="/tools/distribution-planner" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">Distribution Planner</p>
          <p class="text-xs text-text-muted">Just got a per-cap? Make a plan in 2 minutes.</p>
        </div>
      </a>
      <a href="/money/unclaimed" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 11-6.219-8.56" /><path d="M12 7v5l3 2" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">Am I owed money I haven't claimed?</p>
          <p class="text-xs text-text-muted">Benefits are paid from a filed return — and returns can be filed years late</p>
        </div>
      </a>
      <a href="/money/forecast" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 17l5-5 4 3 5-7" /><path d="M3 21h18" /><path d="M3 3v18" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">The Next Eight Weeks</p>
          <p class="text-xs text-text-muted">Money in and out on real dates — and the week it gets tight</p>
        </div>
      </a>
      <a href="/money/budget-tool" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18" /><path d="M9 21V9" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">Budget Snapshot</p>
          <p class="text-xs text-text-muted">See your money picture — income, expenses, what's left</p>
        </div>
      </a>
      <a href="/money/savings-tracker" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">Savings Goals</p>
          <p class="text-xs text-text-muted">Set goals, track progress, celebrate every deposit</p>
        </div>
      </a>
      <a href="/money/net-worth" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">Net Worth Tracker</p>
          <p class="text-xs text-text-muted">Assets minus debts — track it monthly</p>
        </div>
      </a>
      <a href="/money/debt-planner" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 16v3a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h3" /><path d="M8 12h8" /><path d="M12 8v8" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">Debt Payoff Planner</p>
          <p class="text-xs text-text-muted">See when you'll be debt-free and how to get there faster</p>
        </div>
      </a>
      <a href="/tools/settlement-simulator" class="group flex items-center gap-3 rounded-sm bg-white border border-rule hover:border-quiet p-4 transition-all duration-[var(--duration-normal)] active:scale-[0.98]">
        <div class="w-10 h-10 flex items-center justify-center flex-shrink-0 text-faint">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-sm">Settlement Simulator</p>
          <p class="text-xs text-text-muted">See how one decision today shapes the next seven generations</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Articles -->
  <section class="px-5 pb-10">
    <h2 class="text-xs font-semibold text-faint tracking-widest uppercase mb-3">Learn</h2>
    <p class="text-sm text-quiet mb-3">
      Prefer a guided order?
      <a href="/learn" class="text-ink underline decoration-rule underline-offset-2 hover:decoration-ink">Financial Foundations</a>
      walks these in sequence, tools included.
    </p>
    <div class="flex flex-col gap-2.5">
      <TopicCard
        client:idle
        href="/money/banking"
        title="Banking Basics"
        description="Opening an account, choosing a bank, understanding fees — and what to know about on-reserve banking."
        branch="money"
        readTime="5 min"
      />

      <TopicCard
        client:idle
        href="/money/budgeting"
        title="Budgeting That Works"
        description="Simple approaches to tracking what comes in and what goes out — without spreadsheets or stress."
        branch="money"
        readTime="4 min"
      />

      <TopicCard
        client:idle
        href="/money/saving"
        title="Saving and Growing"
        description="TFSAs, FHSAs, RRSPs — what each one does, which ones matter most, and how to start small."
        branch="money"
        readTime="6 min"
      />

      <TopicCard
        client:idle
        href="/money/credit"
        title="Understanding Credit"
        description="What credit scores actually mean, how to build credit, and how to repair it if things went sideways."
        branch="money"
        readTime="5 min"
      />

      <TopicCard
        client:idle
        href="/money/debt"
        title="Dealing with Debt"
        description="Strategies for managing debt without shame. What to tackle first, what to negotiate, when to ask for help."
        branch="money"
        readTime="5 min"
      />

      <TopicCard
        client:idle
        href="/money/investing"
        title="Investing 101"
        description="What investing actually is, how it works, and why starting small and early matters more than being perfect."
        branch="money"
        readTime="7 min"
      />

      <TopicCard
        client:idle
        href="/money/seven-generations"
        title="Seven Generations"
        description="Indigenous communities have been thinking about long-term wealth for millennia. Modern finance is just now catching up."
        branch="money"
        readTime="12 min"
      />

      <TopicCard
        client:idle
        href="/money/taxes"
        title="Taxes and Filing"
        description="When and how to file, what deductions exist, and how Section 87 interacts with your tax return."
        branch="money"
        readTime="6 min"
      />
    </div>
  </section>
</Shell>
