---
/**
 * The landing page.
 *
 * Split: the news down one side, everything else down the other. Two audiences
 * arrive here and neither should have to scroll past the other — someone
 * following what is happening, and someone who came to find a thing.
 *
 * The right-hand side is a directory rather than a feature strip. A one-stop
 * shop only works if you can see what is in the shop, and search only helps
 * someone who already knows what to call the thing they want.
 */
import Shell from '../layouts/Shell.astro';
import ContinueCard from '../components/ContinueCard.svelte';
import NationsPanel from '../components/NationsPanel.astro';
import { DIRECTORY } from '../lib/directory';
import { getEditions } from '../lib/nations-data';
import { formatDate } from '../lib/nations-data';
import { getBcNations } from '../lib/bc-nations';

const recent = getEditions().slice(1, 4);
const bcCount = getBcNations().length;

// The home page shows the first few groups; the rest live on /directory.
const FEATURED = DIRECTORY.slice(0, 5);
---

<Shell
  title="Strong Fire"
  description="Straight answers about money, benefits and your rights for First Nations people. Free, private, and works offline."
  branch="home"
  width="wide"
>
  <section class="px-5 md:px-0 pt-8 md:pt-11 pb-6">
    <p class="text-sm md:text-base text-text-secondary leading-relaxed max-w-2xl">
      <strong class="text-text-primary font-semibold"
        >Straight answers about money, benefits and your rights.</strong
      >
      Free, private, and it works with no signal.
    </p>
  </section>

  <div class="md:grid md:grid-cols-[1.05fr_1fr] md:gap-12 md:items-start">
    <!-- ── The news, down one side ─────────────────────────── -->
    <div class="px-5 md:px-0">
      <NationsPanel variant="lead" />

      {
        recent.length > 0 && (
          <ul class="list-none pl-0 m-0 mt-5 divide-y divide-rule border-t border-rule">
            {recent.map((edition) => (
              <li>
                <a href={edition.url} class="group block py-3.5">
                  <span class="block text-[11px] text-text-muted mb-1">
                    {formatDate(edition.date)}
                    {edition.cadence === 'weekly' ? ' · Weekly' : ''}
                  </span>
                  <span class="block font-record text-[15px] leading-snug text-ink group-hover:text-cedar transition-colors line-clamp-2">
                    {edition.headline}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-4">
        <a
          href="/nations/archive"
          class="text-sm font-medium text-cedar hover:text-cedar-dark transition-colors"
        >
          All editions &rarr;
        </a>
        <a
          href="/nations/bc"
          class="text-xs text-text-muted hover:text-text-secondary transition-colors"
        >
          All {bcCount} BC First Nations
        </a>
      </div>
    </div>

    <!-- ── Everything else, down the other ─────────────────── -->
    <div class="px-5 md:px-0 mt-10 md:mt-0">
      <form action="/search" method="get" role="search" class="mb-7">
        <label for="home-search" class="sr-only">Search Strong Fire</label>
        <div class="relative">
          <svg
            class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-text-muted pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.35-4.35"></path>
          </svg>
          <input
            id="home-search"
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Search — benefits, taxes, Section 87…"
            class="w-full text-base bg-surface-card border border-rule rounded-sm
              pl-12 pr-4 py-3.5 placeholder:text-text-muted
              focus:border-ink focus:outline-none"
          />
        </div>
      </form>

      <div class="mb-7">
        <ContinueCard client:load />
      </div>

      {
        FEATURED.map((section) => (
          <section class="mb-7">
            <h2 class="text-xs font-semibold text-faint tracking-widest uppercase mb-3">
              {section.heading}
            </h2>
            <ul class="list-none pl-0 m-0 divide-y divide-rule border-y border-rule">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="group flex items-baseline gap-3 py-2.5"
                  >
                    <span class="text-[15px] leading-snug group-hover:underline decoration-rule underline-offset-4">{link.label}</span>
                    {link.note && (
                      <span class="text-[11px] text-text-muted ml-auto text-right shrink-0 hidden sm:block">
                        {link.note}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <a
        href="/directory"
        class="inline-block text-sm font-medium text-ink underline decoration-rule underline-offset-2 hover:decoration-ink"
      >
        Everything on this site &rarr;
      </a>
    </div>
  </div>

  <!-- The promise, plainly. -->
  <section class="px-5 md:px-0 pt-12 pb-12">
    <div class="border-t border-rule pt-6">
      <p class="text-sm text-text-secondary leading-relaxed max-w-3xl">
        <strong class="text-text-primary">Strong Fire is free and independent.</strong>
        There is nothing to sign up for and nothing is tracked. Everything you enter — a
        budget, a check-in, a savings goal — stays on your device and is never sent
        anywhere. It is not connected to any bank, firm or government agency, and it is
        general information, not advice about your own situation.
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-4">
        <a
          href="/resources"
          class="text-sm font-medium text-quiet hover:text-ink hover:underline transition-colors"
        >
          Books, organizations and crisis lines &rarr;
        </a>
        <a
          href="/disclaimer"
          class="text-sm text-text-muted hover:text-ink hover:underline transition-colors"
        >
          Disclaimer
        </a>
      </div>
    </div>
  </section>
</Shell>
