---
/**
 * One glossary term, on its own page.
 *
 * The glossary was a single page holding 89 definitions, which made every one
 * of them invisible to search — the whole vocabulary of the site returned as a
 * single result called "Glossary". Someone looking up "RRIF" got a page and a
 * hunt. Now each term is findable, linkable, and can be sent to someone on its
 * own.
 *
 * The combined page stays at /glossary; this sits underneath it.
 */
import type { GetStaticPaths } from 'astro';
import Shell from '../../layouts/Shell.astro';
import { GLOSSARY, CATEGORY_LABELS, type GlossaryEntry } from '../../lib/glossary-data';

/** Slug from a term, dropping any parenthetical expansion. */
export function termSlug(term: string): string {
  return term
    .replace(/\s*\([^)]*\)/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

export const getStaticPaths = (() => {
  const used = new Map<string, string>();

  return GLOSSARY.map((entry) => {
    let slug = termSlug(entry.term);
    if (used.has(slug) && used.get(slug) !== entry.term) slug = `${slug}-${used.size}`;
    used.set(slug, entry.term);

    // "Related" only points somewhere if the related term is really in the glossary.
    const related = (entry.relatedTerms ?? [])
      .map((name) => GLOSSARY.find((g) => g.term === name || g.term.startsWith(`${name} (`)))
      .filter((g): g is GlossaryEntry => Boolean(g));

    return { params: { slug }, props: { entry, related } };
  });
}) satisfies GetStaticPaths;

const { entry, related } = Astro.props;

// Category chips no longer tint by category — a category is not a meaning.
// The label alone carries it.
---

<Shell title={entry.term} description={entry.definition.slice(0, 200)} branch="glossary">
  <div class="px-5 md:px-0 pt-8 md:pt-14 pb-16">
    <a
      href="/glossary"
      class="inline-flex items-center gap-1.5 text-sm text-quiet mb-6 hover:text-ink transition-colors"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
      Glossary
    </a>

    <div class="flex flex-wrap items-center gap-3 mb-3">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight">{entry.term}</h1>
      <span
        class="text-[10px] font-semibold tracking-wide uppercase border border-rule bg-white text-quiet rounded px-2 py-0.5"
      >
        {CATEGORY_LABELS[entry.category]}
      </span>
    </div>

    <p class="text-lg md:text-xl leading-relaxed text-text-primary max-w-[62ch] mb-8">
      {entry.definition}
    </p>

    {
      entry.articleLink && (
        <a
          href={entry.articleLink}
          class="inline-block text-sm font-semibold text-ink underline decoration-rule underline-offset-2 hover:decoration-ink mb-10"
        >
          Read more about this &rarr;
        </a>
      )
    }

    {
      related.length > 0 && (
        <section class="border-t border-rule pt-6 mt-2">
          <h2 class="text-xs font-semibold text-faint tracking-widest uppercase mb-4">
            Related terms
          </h2>
          <ul class="list-none pl-0 m-0 flex flex-col gap-2.5">
            {related.map((r) => (
              <li>
                <a
                  href={`/glossary/${termSlug(r.term)}`}
                  class="group block rounded-sm bg-surface-card border border-rule hover:border-quiet p-4 transition-colors"
                >
                  <p class="font-semibold text-sm">
                    {r.term}
                  </p>
                  <p class="text-sm text-text-secondary mt-1 leading-relaxed line-clamp-2">
                    {r.definition}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Shell>
