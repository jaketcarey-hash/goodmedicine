---
/**
 * The record register — the Nations brief, the archive, the ledger.
 *
 * The organising idea is the evidence margin. Every page on this surface
 * carries its provenance beside the content: when it was checked, where it
 * comes from, how far along it is, how firmly it is known. On desktop that is
 * a right-hand margin behind a hairline; on a phone it is a strip directly
 * under the heading. It is never absent — a page with nothing in its margin
 * is a page that has not said how it knows what it says.
 *
 * Two slots feed it:
 *   evidence — the compressed provenance record: stage, confidence, checked,
 *              sources. Renders as the phone strip and the top of the margin.
 *   rail     — the longer apparatus: who, where, mechanism. Follows the body
 *              on a phone, sits under `evidence` in the margin on desktop.
 */
import Shell from './Shell.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  heading: string;
  standfirst?: string;
  dateline?: string;
  hasRail?: boolean;
  /**
   * `reading` caps the body at a comfortable measure — right for a brief.
   * `full` lets it use the grid width — right for the ledger, which is a
   * table of 42 records and reads worse squeezed into a column.
   */
  measure?: 'reading' | 'full';
}

const {
  title,
  description,
  kicker,
  heading,
  standfirst,
  dateline,
  hasRail = false,
  measure = 'reading',
} = Astro.props;

const hasEvidence = Astro.slots.has('evidence');

// The record has five surfaces and the masthead carries one link to it, so it
// needs its own bar. Current section is matched by path prefix rather than
// passed in, so a new page under /nations gets it for free.
const path = Astro.url.pathname.replace(/\/$/, '') || '/nations';
const SECTIONS = [
  { label: 'Today', href: '/nations', match: (p: string) => p === '/nations' },
  { label: 'Archive', href: '/nations/archive', match: (p: string) => p.startsWith('/nations/archive') },
  { label: 'Ledger', href: '/nations/ledger', match: (p: string) => p.startsWith('/nations/ledger') },
  { label: 'Open questions', href: '/nations/open', match: (p: string) => p === '/nations/open' },
  { label: 'BC directory', href: '/nations/bc', match: (p: string) => p.startsWith('/nations/bc') },
  { label: 'Who', href: '/nations/who', match: (p: string) => p.startsWith('/nations/who') },
];
---

<Shell title={title} description={description} branch="nations" width="wide">
  <div class="px-5 md:px-0 pt-8 md:pt-12 pb-16 md:pb-24">
    <nav
      class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-8 border-b border-rule pb-3"
      aria-label="The Nations"
    >
      {
        SECTIONS.map((section) => {
          const current = section.match(path);
          return (
            <a
              href={section.href}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'apparatus-label pb-px transition-colors duration-[var(--duration-fast)]',
                current
                  ? 'text-ink border-b-2 border-ink -mb-[2px]'
                  : 'hover:text-ink',
              ]}
            >
              {section.label}
            </a>
          );
        })
      }
    </nav>

    <header class="mb-8 md:mb-10">
      {
        (kicker || dateline) && (
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1.5 mb-5">
            {kicker && <p class="apparatus-label text-ink">{kicker}</p>}
            {dateline && <p class="apparatus text-faint">{dateline}</p>}
          </div>
        )
      }

      {/*
        The brief's headline is a full summary sentence, often 200 characters,
        not a five-word masthead. Set at one size it either shouts for six
        lines or looks timid when short, so the size steps down as the
        sentence grows.
      */}
      <h1
        class:list={[
          'leading-[1.12] tracking-[-0.022em] text-ink max-w-4xl font-semibold',
          heading.length > 150
            ? 'text-[25px] md:text-[33px]'
            : heading.length > 80
              ? 'text-[28px] md:text-[40px]'
              : 'text-[32px] md:text-[48px]',
        ]}
      >
        {heading}
      </h1>

      {
        standfirst && (
          <p class="text-[17px] md:text-[19px] leading-[1.6] text-quiet mt-4 max-w-3xl">
            {standfirst}
          </p>
        )
      }
    </header>

    <div
      class:list={[
        hasRail || hasEvidence
          ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_16.5rem] lg:grid-rows-[auto_1fr] lg:gap-x-14'
          : '',
      ]}
    >
      {
        hasEvidence && (
          <aside
            class="border-y border-rule py-4 mb-10 lg:border-y-0 lg:border-l lg:py-0 lg:mb-0 lg:pl-6 lg:col-start-2 lg:row-start-1"
            aria-label="Evidence"
          >
            <slot name="evidence" />
          </aside>
        )
      }

      <div
        class:list={[
          'record-body min-w-0 lg:col-start-1 lg:row-start-1',
          hasEvidence && hasRail && 'lg:row-span-2',
          measure === 'full' && 'record-body--full',
        ]}
      >
        <slot />
      </div>

      {
        hasRail && (
          <aside
            class:list={[
              'mt-14 lg:mt-0 lg:border-l lg:border-rule lg:pl-6 lg:col-start-2',
              hasEvidence ? 'lg:row-start-2 lg:mt-7 lg:pt-7 lg:border-t' : 'lg:row-start-1',
            ]}
          >
            <slot name="rail" />
          </aside>
        )
      }
    </div>
  </div>
</Shell>

<style is:global>
  /* Record typography. The site face for reading; the apparatus voice is
     applied per-element with the `apparatus` utilities, never here. */
  .record-body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
    max-width: 40rem;
  }

  @media (min-width: 768px) {
    .record-body {
      font-size: 1.125rem;
    }
  }

  /* The ledger is a table, not an essay. Prose inside it still wants a
     measure, so cap the paragraphs rather than the container. */
  .record-body--full {
    max-width: none;
  }

  .record-body--full p,
  .record-body--full li {
    max-width: 44rem;
  }

  .record-body p {
    margin-bottom: 1.3rem;
  }

  /* Section headings on this surface are the register's rubric — Where it
     stands, Unresolved, Primary sources — the schema of the record, not its
     content. The rubric speaks in the apparatus voice: every record page
     reads as the same form, filled in. `.plain` remains the documented
     escape hatch for a real headline inside the record body, because this
     block is unlayered and beats any Tailwind utility, however many `!`
     you put on it. */
  .record-body h2:not(.plain) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-faint);
    line-height: 1.4;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-rule);
  }

  /* Content headlines — a brief item, a named development — stay in the
     site face. */
  .record-body h3:not(.plain) {
    font-family: var(--font-body);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin-top: 2.25rem;
    margin-bottom: 0.625rem;
    color: var(--color-ink);
  }

  /* Links in running prose are underlined in the rule grey until wanted.
     Links that *are* a heading are not underlined — a headline with a rule
     under it reads as a link, not a title. */
  .record-body p > a,
  .record-body li > a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 2px;
  }

  .record-body p > a:hover,
  .record-body li > a:hover {
    text-decoration-color: var(--color-ink);
  }

  .record-body h2 a,
  .record-body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .record-body .plain {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-transform: none;
    border: 0;
    padding: 0;
    margin: 0 0 0.5rem;
  }

  @media (min-width: 768px) {
    .record-body .plain { font-size: 1.375rem; }
  }

  .record-body ul,
  .record-body ol {
    margin-bottom: 1.3rem;
    padding-left: 1.25rem;
  }

  .record-body li {
    margin-bottom: 0.5rem;
  }

  .record-body strong {
    font-weight: 600;
  }
</style>
