---
/**
 * The Record register — the Nations brief, the archive, the ledger.
 *
 * Deliberately not the app's voice. Serif text on paper, a cedar rule at the
 * head, an evidence rail at the side. Someone arriving from the community half
 * of the site should feel the change before they read anything, because they
 * have moved from "here is what to do about your money" to "here is what
 * happened and how well we know it".
 *
 * Newsreader is imported here rather than in global.css so the font only
 * downloads on the pages that use it. The community half stays as light as it
 * has always been.
 */
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/400-italic.css';

import Shell from './Shell.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  heading: string;
  standfirst?: string;
  dateline?: string;
  /** Right-hand rail: sources, confidence, anything that evidences the page. */
  hasRail?: boolean;
  /**
   * `reading` caps the body at a comfortable measure — right for a brief.
   * `full` lets it use the grid width — right for the ledger, which is a
   * table of 42 records and reads worse squeezed into a column.
   */
  measure?: 'reading' | 'full';
}

const {
  title,
  description,
  kicker,
  heading,
  standfirst,
  dateline,
  hasRail = false,
  measure = 'reading',
} = Astro.props;

// The Record has five surfaces now and the masthead carries one link to it,
// so it needs its own bar. Current section is matched by path prefix rather
// than passed in, so a new page under /nations gets it for free.
const path = Astro.url.pathname.replace(/\/$/, '') || '/nations';
const SECTIONS = [
  { label: 'Today', href: '/nations', match: (p: string) => p === '/nations' },
  { label: 'Archive', href: '/nations/archive', match: (p: string) => p.startsWith('/nations/archive') },
  { label: 'Ledger', href: '/nations/ledger', match: (p: string) => p.startsWith('/nations/ledger') },
  { label: 'Open questions', href: '/nations/open', match: (p: string) => p === '/nations/open' },
  { label: 'BC directory', href: '/nations/bc', match: (p: string) => p.startsWith('/nations/bc') },
  { label: 'Who', href: '/nations/who', match: (p: string) => p.startsWith('/nations/who') },
];
---

<Shell title={title} description={description} branch="nations" width="wide">
  <div class="px-5 md:px-0 pt-8 md:pt-14 pb-16 md:pb-24">
    <nav
      class="flex flex-wrap items-center gap-x-1 gap-y-1 mb-6 -ml-2.5"
      aria-label="The Nations"
    >
      {
        SECTIONS.map((section) => {
          const current = section.match(path);
          return (
            <a
              href={section.href}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'text-sm px-2.5 py-1.5 rounded transition-colors duration-[var(--duration-normal)]',
                current
                  ? 'text-cedar font-semibold bg-cedar/8'
                  : 'text-text-muted hover:text-cedar hover:bg-cedar/5',
              ]}
            >
              {section.label}
            </a>
          );
        })
      }
    </nav>

    <header class="border-t-[5px] border-cedar pt-6 mb-10 md:mb-14">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-5">
        {
          kicker && (
            <p class="text-[11px] font-bold tracking-[0.15em] uppercase text-cedar">
              {kicker}
            </p>
          )
        }
        {dateline && <p class="text-xs text-text-muted">{dateline}</p>}
      </div>

      {/*
        The brief's headline is a full summary sentence, often 200 characters,
        not a five-word masthead. Set at one size it either shouts for six
        lines or looks timid when short, so the size steps down as the
        sentence grows.
      */}
      <h1
        class:list={[
          'font-record leading-[1.1] tracking-[-0.02em] text-ink max-w-4xl',
          heading.length > 150
            ? 'text-[26px] md:text-[34px]'
            : heading.length > 80
              ? 'text-[30px] md:text-[42px]'
              : 'text-[34px] md:text-[52px]',
        ]}
      >
        {heading}
      </h1>

      {
        standfirst && (
          <p class="font-record text-lg md:text-xl leading-[1.6] text-stone-700 mt-5 max-w-3xl">
            {standfirst}
          </p>
        )
      }
    </header>

    <div
      class:list={[
        hasRail ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-14 lg:items-start' : '',
      ]}
    >
      <div class:list={['record-body', measure === 'full' && 'record-body--full']}>
        <slot />
      </div>

      {
        hasRail && (
          <aside class="mt-14 lg:mt-0 lg:sticky lg:top-24">
            <slot name="rail" />
          </aside>
        )
      }
    </div>
  </div>
</Shell>

<style is:global>
  /* Record typography. Serif for reading, sans for labels and apparatus. */
  .record-body {
    font-family: var(--font-record);
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--color-ink);
    max-width: 40rem;
  }

  @media (min-width: 768px) {
    .record-body {
      font-size: 1.1875rem;
    }
  }

  /* The ledger is a table, not an essay. Prose inside it still wants a
     measure, so cap the paragraphs rather than the container. */
  .record-body--full {
    max-width: none;
  }

  .record-body--full p,
  .record-body--full li {
    max-width: 44rem;
  }

  .record-body p {
    margin-bottom: 1.3rem;
  }

  /* `.plain` opts a heading out of the section-label treatment, for places
     that need a real headline inside the Record body — a list of records, for
     instance. Needed because this block is unlayered and so beats any Tailwind
     utility, however many `!` you put on it. */
  .record-body h2:not(.plain) {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-cedar);
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .record-body h3:not(.plain) {
    font-family: var(--font-record);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-ink);
  }

  /* Links in running prose are underlined. Links that *are* a heading are not —
     a headline with a rule under it reads as a link, not a title.
     Scoped rather than fought with a utility class, because this block is
     unlayered and would beat Tailwind's `no-underline` regardless of order. */
  .record-body p > a,
  .record-body li > a {
    color: var(--color-cedar);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-cedar) 35%, transparent);
    text-underline-offset: 2px;
  }

  .record-body p > a:hover,
  .record-body li > a:hover {
    text-decoration-color: var(--color-cedar);
  }

  .record-body h2 a,
  .record-body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .record-body .plain {
    font-family: var(--font-record);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-transform: none;
    border: 0;
    padding: 0;
    margin: 0 0 0.5rem;
  }

  @media (min-width: 768px) {
    .record-body .plain { font-size: 1.45rem; }
  }

  .record-body .plain a:hover { color: var(--color-cedar); }

  .record-body ul,
  .record-body ol {
    margin-bottom: 1.3rem;
    padding-left: 1.25rem;
  }

  .record-body li {
    margin-bottom: 0.5rem;
  }

  .record-body strong {
    font-weight: 600;
  }
</style>
